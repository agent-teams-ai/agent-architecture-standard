{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.aas.invalid/private/v0/provider.schema.json",
  "title": "AAS provider description",
  "x-aas-status": "private-provisional-unpublished",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "status", "standardVersions", "envelopeVersions", "operations", "profiles", "limits", "extensions", "criticalExtensions"],
  "properties": {
    "schemaVersion": { "const": "0.1" },
    "status": { "const": "private-provisional-unpublished" },
    "standardVersions": { "type": "array", "minItems": 1, "maxItems": 16, "uniqueItems": true, "items": { "$ref": "common.schema.json#/$defs/version" } },
    "envelopeVersions": { "type": "array", "minItems": 1, "maxItems": 16, "uniqueItems": true, "items": { "$ref": "common.schema.json#/$defs/version" } },
    "operations": { "type": "array", "minItems": 1, "maxItems": 64, "items": { "$ref": "common.schema.json#/$defs/profileRef" } },
    "profiles": { "type": "array", "maxItems": 128, "items": { "$ref": "common.schema.json#/$defs/profileRef" } },
    "limits": { "$ref": "common.schema.json#/$defs/budgets" },
    "extensions": { "$ref": "common.schema.json#/$defs/extensionMap" },
    "criticalExtensions": { "$ref": "common.schema.json#/$defs/extensionMap" }
  }
}
