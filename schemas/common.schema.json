{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.aas.invalid/private/v0/common.schema.json",
  "title": "AAS provisional common types",
  "x-aas-status": "private-provisional-unpublished",
  "$defs": {
    "nonnegativeInteger": { "type": "integer", "minimum": 0, "maximum": 9007199254740991 },
    "aasIdentity": { "type": "string", "pattern": "^aas:v0:sha256:[0-9a-f]{64}$" },
    "contentDigest": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
    "identifier": { "type": "string", "minLength": 1, "maxLength": 255, "pattern": "^(?:[a-z][a-z0-9-]*(?:@[0-9]+)?|[a-z][a-z0-9.-]*:[^\\s]+|[a-z][a-z0-9-]*(?:\\.[a-z][a-z0-9-]*)+\\.[a-z0-9][a-z0-9._-]*)$" },
    "definitionVersion": { "type": "string", "minLength": 1, "maxLength": 64, "pattern": "^(?:0|[1-9][0-9]*)(?:\\.(?:0|[1-9][0-9]*)){0,2}(?:-rc\\.[1-9][0-9]*)?$" },
    "version": { "$ref": "#/$defs/definitionVersion" },
    "canonicalSemVer": { "type": "string", "minLength": 5, "maxLength": 64, "pattern": "^(?:0|[1-9][0-9]*)\\.(?:0|[1-9][0-9]*)\\.(?:0|[1-9][0-9]*)(?:-rc\\.[1-9][0-9]*)?$" },
    "envelopeVersion": { "enum": ["0.1"] },
    "schemaBundleVersion": { "enum": ["0.1"] },
    "registryEdition": { "enum": ["1"] },
    "vectorSuiteVersion": { "enum": ["0.1"] },
    "conformanceSuiteVersion": { "enum": ["0.1"] },
    "portablePath": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4096,
      "pattern": "^(?![A-Za-z]:)(?!/)(?!.*\\\\)(?!.*//)(?!.*(?:^|/)\\.{1,2}(?:/|$))(?!.*(?:^|/)(?:[Cc][Oo][Nn]|[Pp][Rr][Nn]|[Aa][Uu][Xx]|[Nn][Uu][Ll]|[Cc][Ll][Oo][Cc][Kk]\\$|[Cc][Oo][Nn][Ii][Nn]\\$|[Cc][Oo][Nn][Oo][Uu][Tt]\\$|[Cc][Oo][Mm][1-9]|[Ll][Pp][Tt][1-9])(?:[./]|$))(?!.*(?:^|/)[^/]*[. ](?:/|$))(?!.*[\\u0000-\\u001f\\u007f-\\u009f\\u061c\\u200e-\\u200f\\u202a-\\u202e\\u2066-\\u2069])[^/]{1,255}(?:/[^/]{1,255}){0,63}$",
      "$comment": "NFC and the normative 255/4096 UTF-8-byte ceilings are additionally enforced by lib/portable-path.mjs; JSON Schema length is code-point based."
    },
    "extensionMap": {
      "type": "object",
      "maxProperties": 64,
      "propertyNames": { "$ref": "#/$defs/identifier" },
      "additionalProperties": true
    },
    "jsonValue": {
      "oneOf": [
        { "type": ["string", "boolean", "null"] },
        { "type": "integer", "minimum": -9007199254740991, "maximum": 9007199254740991 },
        { "type": "array", "maxItems": 10000, "items": { "$ref": "#/$defs/jsonValue" } },
        { "type": "object", "maxProperties": 10000, "additionalProperties": { "$ref": "#/$defs/jsonValue" } }
      ]
    },
    "budgets": {
      "type": "object",
      "additionalProperties": false,
      "required": ["maxInputBytes", "maxDepth", "maxPathSegments", "maxPathBytes", "maxEntries", "maxLogicalBytes", "maxReadBytes", "maxPerEntryBytes", "maxOverlayOperations", "maxTargets", "maxEvidenceReferences", "maxExtensionBytes", "maxDiagnostics", "maxOutputBytes", "maxConcurrency", "maxTotalWork"],
      "properties": {
        "maxInputBytes": { "type": "integer", "minimum": 1, "maximum": 9007199254740991 },
        "maxDepth": { "type": "integer", "minimum": 1, "maximum": 256 },
        "maxPathSegments": { "type": "integer", "minimum": 1, "maximum": 64 },
        "maxPathBytes": { "type": "integer", "minimum": 1, "maximum": 4096 },
        "maxEntries": { "type": "integer", "minimum": 1, "maximum": 1000000 },
        "maxLogicalBytes": { "type": "integer", "minimum": 1, "maximum": 9007199254740991 },
        "maxReadBytes": { "type": "integer", "minimum": 1, "maximum": 9007199254740991 },
        "maxPerEntryBytes": { "type": "integer", "minimum": 1, "maximum": 9007199254740991 },
        "maxOverlayOperations": { "type": "integer", "minimum": 1, "maximum": 100000 },
        "maxTargets": { "type": "integer", "minimum": 1, "maximum": 100000 },
        "maxEvidenceReferences": { "type": "integer", "minimum": 1, "maximum": 1000000 },
        "maxExtensionBytes": { "type": "integer", "minimum": 1, "maximum": 9007199254740991 },
        "maxDiagnostics": { "type": "integer", "minimum": 1, "maximum": 1000000 },
        "maxOutputBytes": { "type": "integer", "minimum": 1, "maximum": 9007199254740991 },
        "maxConcurrency": { "type": "integer", "minimum": 1, "maximum": 100000 },
        "maxTotalWork": { "type": "integer", "minimum": 1, "maximum": 9007199254740991 }
      }
    },
    "profileRef": {
      "type": "object",
      "additionalProperties": false,
      "required": ["version", "id", "aasIdentity"],
      "properties": {
        "version": { "$ref": "#/$defs/definitionVersion" },
        "id": { "$ref": "#/$defs/identifier" },
        "aasIdentity": { "$ref": "#/$defs/aasIdentity" }
      }
    },
    "artifactRef": {
      "type": "object",
      "additionalProperties": false,
      "required": ["aasIdentity", "contentDigest", "byteLength", "mediaType"],
      "properties": {
        "aasIdentity": { "$ref": "#/$defs/aasIdentity" },
        "contentDigest": { "$ref": "#/$defs/contentDigest" },
        "byteLength": { "type": "integer", "minimum": 0, "maximum": 9007199254740991 },
        "mediaType": { "type": "string", "minLength": 1, "maxLength": 127, "pattern": "^[A-Za-z0-9!#$&^_.+-]+/[A-Za-z0-9!#$&^_.+-]+$" }
      }
    }
  },
  "type": "object",
  "additionalProperties": false,
  "maxProperties": 0
}
