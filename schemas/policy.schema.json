{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.aas.invalid/private/v0/policy.schema.json",
  "title": "AAS effective policy, binding, and exception",
  "x-aas-status": "private-provisional-unpublished",
  "$defs": {
    "exception": {
      "type": "object", "additionalProperties": false,
      "required": ["aasIdentity", "ruleId", "scope", "owner", "reasonCode", "creationPolicyAasIdentity", "validForRevision"],
      "properties": {
        "aasIdentity": { "$ref": "common.schema.json#/$defs/aasIdentity" },
        "ruleId": { "$ref": "common.schema.json#/$defs/identifier" },
        "scope": { "$ref": "common.schema.json#/$defs/portablePath" },
        "owner": { "type": "string", "minLength": 1, "maxLength": 255 },
        "reasonCode": { "$ref": "common.schema.json#/$defs/identifier" },
        "creationPolicyAasIdentity": { "$ref": "common.schema.json#/$defs/aasIdentity" },
        "validForRevision": { "$ref": "common.schema.json#/$defs/aasIdentity" }
      }
    },
    "effectivePolicy": {
      "type": "object", "additionalProperties": false,
      "required": ["schemaVersion", "aasIdentity", "consumer", "scope", "profiles", "rules", "exceptions", "provenance"],
      "properties": {
        "schemaVersion": { "const": "0.1" },
        "aasIdentity": { "$ref": "common.schema.json#/$defs/aasIdentity" },
        "consumer": { "$ref": "common.schema.json#/$defs/identifier" },
        "scope": { "$ref": "common.schema.json#/$defs/portablePath" },
        "profiles": { "type": "array", "minItems": 1, "maxItems": 128, "items": { "$ref": "common.schema.json#/$defs/profileRef" } },
        "rules": { "type": "array", "maxItems": 10000, "items": { "type": "object", "additionalProperties": false, "required": ["id", "parameters"], "properties": { "id": { "$ref": "common.schema.json#/$defs/identifier" }, "parameters": { "type": "object", "maxProperties": 64, "additionalProperties": true } } } },
        "exceptions": { "type": "array", "maxItems": 10000, "items": { "$ref": "#/$defs/exception" } },
        "provenance": { "type": "array", "minItems": 1, "maxItems": 1024, "items": { "$ref": "common.schema.json#/$defs/artifactRef" } }
      }
    },
    "binding": {
      "type": "object", "additionalProperties": false,
      "required": ["schemaVersion", "aasIdentity", "id", "consumer", "repository", "scope", "rolloutScope", "mode", "policyAasIdentity", "profiles", "budgets", "exceptions", "owner"],
      "properties": {
        "schemaVersion": { "const": "0.1" },
        "aasIdentity": { "$ref": "common.schema.json#/$defs/aasIdentity" },
        "id": { "$ref": "common.schema.json#/$defs/identifier" },
        "consumer": { "$ref": "common.schema.json#/$defs/identifier" },
        "repository": { "$ref": "common.schema.json#/$defs/identifier" },
        "scope": { "$ref": "common.schema.json#/$defs/portablePath" },
        "rolloutScope": { "type": "string", "minLength": 1, "maxLength": 1024 },
        "mode": { "enum": ["shadow", "advisory", "required"] },
        "policyAasIdentity": { "$ref": "common.schema.json#/$defs/aasIdentity" },
        "profiles": { "type": "array", "minItems": 1, "maxItems": 128, "items": { "$ref": "common.schema.json#/$defs/profileRef" } },
        "budgets": { "$ref": "common.schema.json#/$defs/budgets" },
        "exceptions": { "type": "array", "maxItems": 10000, "items": { "$ref": "common.schema.json#/$defs/aasIdentity" } },
        "owner": { "type": "string", "minLength": 1, "maxLength": 255 }
      }
    }
  },
  "oneOf": [{ "$ref": "#/$defs/effectivePolicy" }, { "$ref": "#/$defs/binding" }, { "$ref": "#/$defs/exception" }]
}
