{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.aas.invalid/private/v0/conformance.schema.json",
  "title": "AAS conformance claim, report, release manifest, and qualification sidecar",
  "x-aas-status": "private-provisional-unpublished",
  "$defs": {
    "claim": { "type": "object", "additionalProperties": false, "required": ["schemaVersion", "status", "visibility", "qualification", "claimant", "providerArtifact", "standardVersion", "profiles", "suiteArtifact", "reportArtifacts", "limitations"], "properties": { "schemaVersion": { "const": "0.1" }, "status": { "const": "provisional" }, "visibility": { "const": "private" }, "qualification": { "const": "unqualified" }, "claimant": { "type": "string", "minLength": 1, "maxLength": 255 }, "providerArtifact": { "$ref": "common.schema.json#/$defs/artifactRef" }, "standardVersion": { "$ref": "common.schema.json#/$defs/version" }, "profiles": { "type": "array", "minItems": 1, "maxItems": 128, "items": { "$ref": "common.schema.json#/$defs/profileRef" } }, "suiteArtifact": { "$ref": "common.schema.json#/$defs/artifactRef" }, "reportArtifacts": { "type": "array", "minItems": 1, "maxItems": 1024, "items": { "$ref": "common.schema.json#/$defs/artifactRef" } }, "limitations": { "type": "array", "maxItems": 1024, "items": { "type": "string", "maxLength": 1024 } } } },
    "report": { "type": "object", "additionalProperties": false, "required": ["schemaVersion", "sourceRevision", "runnerArtifact", "providerArtifact", "fixtureDigests", "platform", "results", "omissions"], "properties": { "schemaVersion": { "const": "0.1" }, "sourceRevision": { "type": "string", "minLength": 1, "maxLength": 128 }, "runnerArtifact": { "$ref": "common.schema.json#/$defs/artifactRef" }, "providerArtifact": { "$ref": "common.schema.json#/$defs/artifactRef" }, "fixtureDigests": { "type": "array", "maxItems": 100000, "uniqueItems": true, "items": { "$ref": "common.schema.json#/$defs/contentDigest" } }, "platform": { "type": "string", "minLength": 1, "maxLength": 255 }, "results": { "type": "array", "maxItems": 100000, "items": { "type": "object", "additionalProperties": false, "required": ["caseId", "outcome"], "properties": { "caseId": { "$ref": "common.schema.json#/$defs/identifier" }, "outcome": { "enum": ["pass", "fail"] } } } }, "omissions": { "type": "array", "maxItems": 100000, "items": { "type": "string", "maxLength": 1024 } } } },
    "qualificationSidecar": { "type": "object", "additionalProperties": false, "required": ["schemaVersion", "subject", "status", "evidence"], "properties": { "schemaVersion": { "const": "0.1" }, "subject": { "$ref": "common.schema.json#/$defs/artifactRef" }, "status": { "enum": ["provisional", "qualified", "suspended", "withdrawn", "expired"] }, "evidence": { "type": "array", "minItems": 1, "maxItems": 1024, "items": { "$ref": "common.schema.json#/$defs/artifactRef" } } } },
    "releaseManifest": { "type": "object", "additionalProperties": false, "required": ["schemaVersion", "cohort", "maturity", "members", "dependencies", "qualificationSidecars", "completionStatus", "limitations"], "properties": { "schemaVersion": { "const": "0.1" }, "cohort": { "$ref": "common.schema.json#/$defs/identifier" }, "maturity": { "const": "experimental" }, "members": { "type": "array", "minItems": 1, "maxItems": 1024, "items": { "type": "object", "additionalProperties": false, "required": ["name", "version", "artifact"], "properties": { "name": { "$ref": "common.schema.json#/$defs/identifier" }, "version": { "$ref": "common.schema.json#/$defs/version" }, "artifact": { "$ref": "common.schema.json#/$defs/artifactRef" } } } }, "dependencies": { "type": "array", "maxItems": 4096, "items": { "type": "object", "additionalProperties": false, "required": ["from", "to"], "properties": { "from": { "$ref": "common.schema.json#/$defs/identifier" }, "to": { "$ref": "common.schema.json#/$defs/identifier" } } } }, "qualificationSidecars": { "type": "array", "maxItems": 1024, "items": { "$ref": "common.schema.json#/$defs/aasIdentity" } }, "completionStatus": { "enum": ["incomplete", "complete"] }, "limitations": { "type": "array", "maxItems": 1024, "items": { "type": "string", "maxLength": 1024 } } } }
  },
  "oneOf": [{ "$ref": "#/$defs/claim" }, { "$ref": "#/$defs/report" }, { "$ref": "#/$defs/qualificationSidecar" }, { "$ref": "#/$defs/releaseManifest" }]
}
