{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.aas.invalid/private/v0/identity-documents.schema.json",
  "title": "AAS private provisional identity-bearing documents",
  "x-aas-status": "private-provisional-unpublished",
  "$defs": {
    "repositoryRevision": {
      "type": "object",
      "additionalProperties": false,
      "required": ["aasIdentity", "repositoryId", "revisionSystemProfile", "nativeRevision", "treeAasIdentity"],
      "properties": {
        "aasIdentity": { "$ref": "common.schema.json#/$defs/aasIdentity" },
        "repositoryId": { "$ref": "common.schema.json#/$defs/identifier" },
        "revisionSystemProfile": { "$ref": "common.schema.json#/$defs/profileRef" },
        "nativeRevision": { "type": "string", "minLength": 1, "maxLength": 512 },
        "treeAasIdentity": { "$ref": "common.schema.json#/$defs/aasIdentity" }
      }
    },
    "profile": {
      "type": "object",
      "additionalProperties": false,
      "required": ["aasIdentity", "kind", "id", "definitionVersion", "schemas", "dependencies", "limits", "semanticsArtifacts", "definitionVectorSuites"],
      "properties": {
        "aasIdentity": { "$ref": "common.schema.json#/$defs/aasIdentity" },
        "kind": { "enum": ["canonicalization", "operation", "vocabulary", "evaluator", "security", "path", "diagnostic", "accounting"] },
        "id": { "$ref": "common.schema.json#/$defs/identifier" },
        "definitionVersion": { "$ref": "common.schema.json#/$defs/version" },
        "schemas": { "type": "array", "minItems": 1, "maxItems": 128, "items": { "$ref": "common.schema.json#/$defs/artifactRef" } },
        "dependencies": { "type": "array", "maxItems": 128, "items": { "$ref": "common.schema.json#/$defs/profileRef" } },
        "limits": { "$ref": "common.schema.json#/$defs/budgets" },
        "semanticsArtifacts": { "type": "array", "minItems": 1, "maxItems": 128, "items": { "$ref": "common.schema.json#/$defs/artifactRef" } },
        "definitionVectorSuites": { "type": "array", "minItems": 1, "maxItems": 128, "items": { "$ref": "common.schema.json#/$defs/artifactRef" } }
      }
    },
    "analyzer": {
      "type": "object",
      "additionalProperties": false,
      "required": ["aasIdentity", "implementationArtifacts", "configuration", "profiles"],
      "properties": {
        "aasIdentity": { "$ref": "common.schema.json#/$defs/aasIdentity" },
        "implementationArtifacts": { "type": "array", "minItems": 1, "maxItems": 128, "items": { "$ref": "common.schema.json#/$defs/artifactRef" } },
        "configuration": { "type": "array", "maxItems": 128, "items": { "$ref": "#/$defs/configurationEntry" } },
        "profiles": { "type": "array", "minItems": 1, "maxItems": 128, "items": { "$ref": "common.schema.json#/$defs/profileRef" } }
      }
    },
    "configurationEntry": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "value"],
      "properties": {
        "name": { "$ref": "common.schema.json#/$defs/identifier" },
        "value": { "$ref": "common.schema.json#/$defs/jsonValue" }
      }
    },
    "promotionRecord": {
      "type": "object",
      "additionalProperties": false,
      "required": ["aasIdentity", "ruleId", "consumer", "policy", "profiles", "analyzerAasIdentity", "rolloutScope", "previousMode", "nextMode", "evidence", "denominator", "escapes", "falseBlocks", "incidents", "owner", "rollbackAction", "responseSla"],
      "properties": {
        "aasIdentity": { "$ref": "common.schema.json#/$defs/aasIdentity" },
        "ruleId": { "$ref": "common.schema.json#/$defs/identifier" },
        "consumer": { "$ref": "common.schema.json#/$defs/identifier" },
        "policy": { "$ref": "common.schema.json#/$defs/aasIdentity" },
        "profiles": { "type": "array", "minItems": 1, "maxItems": 128, "items": { "$ref": "common.schema.json#/$defs/profileRef" } },
        "analyzerAasIdentity": { "$ref": "common.schema.json#/$defs/aasIdentity" },
        "rolloutScope": { "type": "string", "minLength": 1, "maxLength": 1024 },
        "previousMode": { "enum": ["shadow", "advisory"] },
        "nextMode": { "enum": ["advisory", "required"] },
        "evidence": { "type": "array", "minItems": 1, "maxItems": 1024, "items": { "$ref": "common.schema.json#/$defs/artifactRef" } },
        "denominator": { "$ref": "common.schema.json#/$defs/nonnegativeInteger" },
        "escapes": { "$ref": "common.schema.json#/$defs/nonnegativeInteger" },
        "falseBlocks": { "$ref": "common.schema.json#/$defs/nonnegativeInteger" },
        "incidents": { "$ref": "common.schema.json#/$defs/nonnegativeInteger" },
        "owner": { "type": "string", "minLength": 1, "maxLength": 255 },
        "rollbackAction": { "$ref": "common.schema.json#/$defs/identifier" },
        "responseSla": { "type": "string", "minLength": 1, "maxLength": 255 }
      }
    },
    "analysisKey": {
      "type": "object",
      "additionalProperties": false,
      "required": ["aasIdentity", "operationProfile", "evaluatorProfiles", "inputAasIdentities", "budgets", "accountingProfile", "semanticExtensions"],
      "properties": {
        "aasIdentity": { "$ref": "common.schema.json#/$defs/aasIdentity" },
        "operationProfile": { "$ref": "common.schema.json#/$defs/profileRef" },
        "evaluatorProfiles": { "type": "array", "maxItems": 128, "items": { "$ref": "common.schema.json#/$defs/profileRef" } },
        "inputAasIdentities": { "type": "array", "minItems": 1, "maxItems": 100000, "items": { "$ref": "common.schema.json#/$defs/aasIdentity" } },
        "budgets": { "$ref": "common.schema.json#/$defs/budgets" },
        "accountingProfile": { "$ref": "common.schema.json#/$defs/profileRef" },
        "semanticExtensions": { "$ref": "common.schema.json#/$defs/extensionMap" }
      }
    }
  },
  "oneOf": [
    { "$ref": "artifacts.schema.json#/$defs/artifact" },
    { "$ref": "artifacts.schema.json#/$defs/snapshot" },
    { "$ref": "#/$defs/profile" },
    { "$ref": "policy.schema.json#/$defs/effectivePolicy" },
    { "$ref": "#/$defs/repositoryRevision" },
    { "$ref": "policy.schema.json#/$defs/exception" },
    { "$ref": "#/$defs/promotionRecord" },
    { "$ref": "policy.schema.json#/$defs/binding" },
    { "$ref": "#/$defs/analyzer" },
    { "$ref": "overlay.schema.json#/$defs/overlay" },
    { "$ref": "envelope.schema.json#/$defs/request" },
    { "$ref": "#/$defs/analysisKey" },
    { "$ref": "envelope.schema.json#/$defs/result" },
    { "$ref": "overlay.schema.json#/$defs/receipt" },
    { "$ref": "conformance.schema.json#/$defs/releaseManifest" }
  ]
}
