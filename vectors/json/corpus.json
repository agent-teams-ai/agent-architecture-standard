{
  "schemaVersion": "0.1",
  "status": "private-provisional-unqualified",
  "cases": [
    {
      "caseId": "raw-bytes-required",
      "requirement": "spec/identity.md#2-strict-i-json-input-profile",
      "input": { "reference": "vectors/json/negative/raw-bytes-required.json", "form": "decoded-text" },
      "limits": { "maxBytes": 1048576, "maxDepth": 64 },
      "expected": { "diagnostic": "aas.json.raw-bytes-required", "version": "0.1" },
      "rationale": "The language-neutral case declares a decoded-text API input; strict parsing requires the packaged raw bytes instead."
    },
    { "caseId": "null-prototype", "requirement": "spec/identity.md#2-strict-i-json-input-profile", "input": { "reference": "vectors/json/positive/null-prototype.json" }, "limits": { "maxBytes": 1048576, "maxDepth": 64 }, "expected": { "diagnostic": "none", "version": "0.1" }, "rationale": "Decoded objects are constructed with null prototypes." },
    { "caseId": "prototype-keys-inert", "requirement": "spec/security-and-conformance.md#5-inert-data-and-denied-capabilities", "input": { "reference": "vectors/json/positive/prototype-keys.json" }, "limits": { "maxBytes": 1048576, "maxDepth": 64 }, "expected": { "diagnostic": "none", "version": "0.1" }, "rationale": "Ordinary JSON member names remain safe because construction uses null-prototype objects." },
    { "caseId": "integer-spellings", "requirement": "spec/identity.md#2-strict-i-json-input-profile", "input": { "reference": "vectors/json/positive/integer-spellings.json" }, "limits": { "maxBytes": 1048576, "maxDepth": 64 }, "expected": { "diagnostic": "none", "version": "0.1" }, "rationale": "Valid JSON decimal and exponent spellings are accepted when their decoded value is a safe integer." },
    { "caseId": "duplicate-key", "requirement": "spec/identity.md#2-strict-i-json-input-profile", "input": { "reference": "vectors/json/negative/duplicate-key.json" }, "limits": { "maxBytes": 1048576, "maxDepth": 64 }, "expected": { "diagnostic": "aas.json.duplicate-key", "version": "0.1" }, "rationale": "Duplicate decoded member names are ambiguous and rejected." },
    { "caseId": "duplicate-escaped-key", "requirement": "spec/identity.md#2-strict-i-json-input-profile", "input": { "reference": "vectors/json/negative/duplicate-escaped-key.json" }, "limits": { "maxBytes": 1048576, "maxDepth": 64 }, "expected": { "diagnostic": "aas.json.duplicate-key", "version": "0.1" }, "rationale": "Escape spelling does not make a duplicate decoded member distinct." },
    { "caseId": "fraction", "requirement": "spec/identity.md#2-strict-i-json-input-profile", "input": { "reference": "vectors/json/negative/fraction.json" }, "limits": { "maxBytes": 1048576, "maxDepth": 64 }, "expected": { "diagnostic": "aas.json.invalid-number", "version": "0.1" }, "rationale": "A decoded fractional value is outside the safe-integer profile." },
    { "caseId": "negative-zero", "requirement": "spec/identity.md#2-strict-i-json-input-profile", "input": { "reference": "vectors/json/negative/negative-zero.json" }, "limits": { "maxBytes": 1048576, "maxDepth": 64 }, "expected": { "diagnostic": "aas.json.invalid-number", "version": "0.1" }, "rationale": "Negative zero is forbidden even though it compares equal to zero." },
    { "caseId": "unsafe-integer", "requirement": "spec/identity.md#2-strict-i-json-input-profile", "input": { "reference": "vectors/json/negative/unsafe-integer.json" }, "limits": { "maxBytes": 1048576, "maxDepth": 64 }, "expected": { "diagnostic": "aas.json.invalid-number", "version": "0.1" }, "rationale": "Values outside the exact safe-integer range are rejected." },
    { "caseId": "depth", "requirement": "spec/security-and-conformance.md#6-resource-limits-and-privacy", "input": { "reference": "vectors/json/negative/depth.json" }, "limits": { "maxBytes": 1000, "maxDepth": 3 }, "expected": { "diagnostic": "aas.json.depth-exceeded", "version": "0.1" }, "rationale": "Nesting cannot exceed the declared deterministic depth." },
    { "caseId": "input-too-large", "requirement": "spec/security-and-conformance.md#6-resource-limits-and-privacy", "input": { "reference": "vectors/json/negative/input-too-large.json" }, "limits": { "maxBytes": 11, "maxDepth": 64 }, "expected": { "diagnostic": "aas.json.input-too-large", "version": "0.1" }, "rationale": "Encoded bytes are bounded before decoding or allocation." },
    { "caseId": "bom", "requirement": "spec/identity.md#2-strict-i-json-input-profile", "input": { "reference": "vectors/json/negative/bom.json", "prefixHex": "efbbbf" }, "limits": { "maxBytes": 1048576, "maxDepth": 64 }, "expected": { "diagnostic": "aas.json.invalid-utf8", "version": "0.1" }, "rationale": "A UTF-8 BOM is not accepted as invisible input state." },
    { "caseId": "lone-surrogate", "requirement": "spec/identity.md#2-strict-i-json-input-profile", "input": { "reference": "vectors/json/negative/lone-surrogate.json" }, "limits": { "maxBytes": 1048576, "maxDepth": 64 }, "expected": { "diagnostic": "aas.json.invalid-syntax", "version": "0.1" }, "rationale": "Lone surrogate code units are not I-JSON strings." },
    { "caseId": "trailing-root", "requirement": "spec/identity.md#2-strict-i-json-input-profile", "input": { "reference": "vectors/json/negative/trailing-root.json" }, "limits": { "maxBytes": 1048576, "maxDepth": 64 }, "expected": { "diagnostic": "aas.json.invalid-syntax", "version": "0.1" }, "rationale": "Exactly one JSON root value is required." },
    { "caseId": "rounded-safe-maximum", "requirement": "spec/identity.md#2-strict-i-json-input-profile", "input": { "reference": "vectors/json/negative/rounded-safe-maximum.json" }, "limits": { "maxBytes": 1048576, "maxDepth": 64 }, "expected": { "diagnostic": "aas.json.invalid-number", "version": "0.1" }, "rationale": "The mathematical decimal is fractional even if binary64 conversion would round it to MAX_SAFE_INTEGER." },
    { "caseId": "rounded-one", "requirement": "spec/identity.md#2-strict-i-json-input-profile", "input": { "reference": "vectors/json/negative/rounded-one.json" }, "limits": { "maxBytes": 1048576, "maxDepth": 64 }, "expected": { "diagnostic": "aas.json.invalid-number", "version": "0.1" }, "rationale": "A fractional decimal cannot enter the profile by rounding to one." },
    { "caseId": "exact-scaled-integer", "requirement": "spec/identity.md#2-strict-i-json-input-profile", "input": { "reference": "vectors/json/positive/exact-scaled-integer.json" }, "limits": { "maxBytes": 1048576, "maxDepth": 64 }, "expected": { "diagnostic": "none", "version": "0.1" }, "rationale": "A decimal-exponent spelling is accepted when its exact mathematical value is an in-range integer." },
    { "caseId": "large-exact-safe-integer-spelling", "requirement": "spec/identity.md#2-strict-i-json-input-profile", "input": { "constructedToken": { "prefix": "1", "repeat": { "text": "0", "count": 100001 }, "suffix": "e-100001" } }, "limits": { "maxBytes": 1048576, "maxDepth": 64 }, "expected": { "diagnostic": "none", "value": 1, "version": "0.1" }, "rationale": "A roughly 100 KB spelling beyond the former 100000 scale ceiling decodes to mathematical one without expansive power allocation." }
  ]
}
