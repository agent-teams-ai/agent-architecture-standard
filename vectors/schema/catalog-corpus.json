{
  "schemaVersion": "0.1",
  "status": "private-provisional-unqualified",
  "cases": [
    { "caseId": "duplicate-schema-id", "requirement": "schemas/readme.md#offline-and-closed-world-resolution", "input": { "operation": "graph", "schemas": [{ "$id": "https://schemas.aas.invalid/private/v0/a.schema.json" }, { "$id": "https://schemas.aas.invalid/private/v0/a.schema.json" }] }, "limits": { "maxSchemas": 2, "maxDepth": 8 }, "expected": { "diagnostic": "aas.schema.duplicate-id", "version": "0.1" }, "rationale": "A catalog ID identifies exactly one resource." },
    { "caseId": "aliased-schema-id", "requirement": "schemas/readme.md#offline-and-closed-world-resolution", "input": { "operation": "graph", "schemas": [{ "$id": "https://schemas.aas.invalid/private/v0/A.schema.json" }] }, "limits": { "maxSchemas": 1, "maxDepth": 8 }, "expected": { "diagnostic": "aas.schema.alias-id", "version": "0.1" }, "rationale": "Catalog paths and IDs use one lowercase exact spelling." },
    { "caseId": "nested-id-alias", "requirement": "schemas/readme.md#offline-and-closed-world-resolution", "input": { "operation": "graph", "schemas": [{ "$id": "https://schemas.aas.invalid/private/v0/a.schema.json", "$defs": { "escape": { "$id": "alias.schema.json" } } }] }, "limits": { "maxSchemas": 1, "maxDepth": 8 }, "expected": { "diagnostic": "aas.schema.alias-id", "version": "0.1" }, "rationale": "Nested resource identifiers cannot create an unlisted embedded resource." },
    { "caseId": "nested-anchor-alias", "requirement": "schemas/readme.md#offline-and-closed-world-resolution", "input": { "operation": "graph", "schemas": [{ "$id": "https://schemas.aas.invalid/private/v0/a.schema.json", "$defs": { "escape": { "$anchor": "alias" } } }] }, "limits": { "maxSchemas": 1, "maxDepth": 8 }, "expected": { "diagnostic": "aas.schema.alias-id", "version": "0.1" }, "rationale": "Anchors cannot introduce an alternate catalog name." },
    { "caseId": "dynamic-reference", "requirement": "security-and-conformance.md#5-inert-data-and-denied-capabilities", "input": { "operation": "graph", "schemas": [{ "$id": "https://schemas.aas.invalid/private/v0/a.schema.json", "$dynamicRef": "#alias" }] }, "limits": { "maxSchemas": 1, "maxDepth": 8 }, "expected": { "diagnostic": "aas.schema.network-ref", "version": "0.1" }, "rationale": "Dynamic resolution is outside the static offline catalog." },
    { "caseId": "recursive-reference", "requirement": "security-and-conformance.md#5-inert-data-and-denied-capabilities", "input": { "operation": "graph", "schemas": [{ "$id": "https://schemas.aas.invalid/private/v0/a.schema.json", "$recursiveRef": "#" }] }, "limits": { "maxSchemas": 1, "maxDepth": 8 }, "expected": { "diagnostic": "aas.schema.network-ref", "version": "0.1" }, "rationale": "Legacy recursive resolution is outside the static offline catalog." },
    { "caseId": "nested-meta-schema-escape", "requirement": "security-and-conformance.md#5-inert-data-and-denied-capabilities", "input": { "operation": "graph", "schemas": [{ "$id": "https://schemas.aas.invalid/private/v0/a.schema.json", "$defs": { "escape": { "$schema": "https://example.invalid/meta" } } }] }, "limits": { "maxSchemas": 1, "maxDepth": 8 }, "expected": { "diagnostic": "aas.schema.network-ref", "version": "0.1" }, "rationale": "An embedded subschema cannot replace the catalog meta-schema or trigger resolution." },
    { "caseId": "external-reference-cycle", "requirement": "schemas/readme.md#offline-and-closed-world-resolution", "input": { "operation": "graph", "schemas": [{ "$id": "https://schemas.aas.invalid/private/v0/a.schema.json", "$ref": "b.schema.json" }, { "$id": "https://schemas.aas.invalid/private/v0/b.schema.json", "$ref": "a.schema.json" }] }, "limits": { "maxSchemas": 2, "maxDepth": 8 }, "expected": { "diagnostic": "aas.schema.ref-cycle", "version": "0.1" }, "rationale": "The external schema dependency graph is acyclic." },
    { "caseId": "unknown-local-reference", "requirement": "schemas/readme.md#offline-and-closed-world-resolution", "input": { "operation": "graph", "schemas": [{ "$id": "https://schemas.aas.invalid/private/v0/a.schema.json", "$ref": "missing.schema.json" }] }, "limits": { "maxSchemas": 1, "maxDepth": 8 }, "expected": { "diagnostic": "aas.schema.unknown-id", "version": "0.1" }, "rationale": "Every non-fragment reference resolves from the exact supplied catalog." },
    { "caseId": "network-reference", "requirement": "security-and-conformance.md#5-inert-data-and-denied-capabilities", "input": { "operation": "graph", "schemas": [{ "$id": "https://schemas.aas.invalid/private/v0/a.schema.json", "$ref": "https://example.invalid/x" }] }, "limits": { "maxSchemas": 1, "maxDepth": 8 }, "expected": { "diagnostic": "aas.schema.network-ref", "version": "0.1" }, "rationale": "Schema validation never dereferences the network." },
    { "caseId": "filesystem-reference", "requirement": "security-and-conformance.md#5-inert-data-and-denied-capabilities", "input": { "operation": "graph", "schemas": [{ "$id": "https://schemas.aas.invalid/private/v0/a.schema.json", "$ref": "/etc/passwd" }] }, "limits": { "maxSchemas": 1, "maxDepth": 8 }, "expected": { "diagnostic": "aas.schema.network-ref", "version": "0.1" }, "rationale": "Absolute filesystem references cannot escape the supplied catalog." },
    { "caseId": "relative-path-escape", "requirement": "security-and-conformance.md#5-inert-data-and-denied-capabilities", "input": { "operation": "graph", "schemas": [{ "$id": "https://schemas.aas.invalid/private/v0/a.schema.json", "$ref": "../escape.schema.json" }] }, "limits": { "maxSchemas": 1, "maxDepth": 8 }, "expected": { "diagnostic": "aas.schema.alias-id", "version": "0.1" }, "rationale": "Relative path traversal cannot escape the supplied catalog." }
  ]
}
